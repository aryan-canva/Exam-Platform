{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Watchdog": {
    "ServerUrl": "http://localhost:8080",
    "StateDir": "C:\\ProgramData\\ExamWatchdog",
    "ControlHost": "127.0.0.1",
    "ControlPort": 8765,
    "RunAsWindowsService": false,
    "AutoStartSessionFromConfig": false,
    "ContestId": "",
    "Username": "",
    "Password": "",
    "AccessToken": "",
    "EnforceProcessMonitor": true,
    "EnforceFirewall": false,
    "EnforceUsb": false,
    "EnforceShellLockdown": false,
    "DefaultAllowedProcesses": [ "examclient", "student-app", "electron", "msedgewebview2" ],
    "ForbiddenProcesses": [ "chrome", "msedge", "firefox", "brave", "opera", "discord", "telegram", "whatsapp", "teams", "slack", "zoom", "skype", "anydesk", "teamviewer", "cmd", "powershell", "pwsh", "taskmgr", "regedit" ]
  }
}
