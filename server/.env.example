# Copy to ".env" next to docker-compose.yml. Generate secrets with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me
APP_JWT_SECRET=change-me-at-least-32-random-bytes-long-................
APP_JUDGE_WORKER_TOKEN=change-me-shared-with-judge-workers
# Signs the student event chain (per-session key = HMAC of the session id). Do not reuse the JWT secret.
APP_INTEGRITY_SECRET=change-me-another-32-random-bytes-................
# Browsers allowed to call the API (teacher UI origin). "*" is fine on a closed LAN.
APP_CORS_ALLOWED_ORIGINS=*
# true = the server refuses to start while any secret above still looks like a placeholder (recommended once reachable from a network).
APP_REQUIRE_STRONG_SECRETS=true
